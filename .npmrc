save-exact=true
engine-strict=true
; Resolve only package versions published at least 7 days ago (npm >= 11.10).
; Supply-chain guard: newly published versions are the malicious-takeover
; window. npm 11.10+ applies it by resolving `before` to now minus 7 days;
; older npm (Node 22 ships 10.9.x) stores the key but has no handler for it,
; so it is silently inert there rather than an error. `npm ci` installs from
; the lockfile and is unaffected on either.
min-release-age=7

; Auth for the @afixt scope. The repo publishes as @afixt/apg-react and today
; consumes no @afixt package, so this is dormant — it exists so the first
; @afixt dependency does not break `npm ci` in CI. NPM_TOKEN comes from the
; organization-level Actions secret; do not add a repo-level override.
; `always-auth` is deliberately absent: npm removed it in v9.
@afixt:registry=https://registry.npmjs.org/
//registry.npmjs.org/:_authToken=${NPM_TOKEN}
