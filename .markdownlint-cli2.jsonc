{
  "config": {
    "default": true,
    "MD003": { "style": "atx" },
    "MD004": { "style": "dash" },
    "MD007": { "indent": 2 },
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD025": true,
    "MD029": { "style": "ordered" },
    "MD033": {
      "allowed_elements": ["br", "details", "summary", "kbd", "sub", "sup"],
    },
    "MD040": true,
    "MD041": true,
    "MD046": { "style": "fenced" },
    "MD048": { "style": "backtick" },
    "MD049": { "style": "underscore" },
    "MD050": { "style": "asterisk" },
    "MD053": true,
  },
  // The authoritative exclusions, rather than the `#node_modules` glob on the
  // command line -- keeping them here means `markdownlint:fix` and any direct
  // invocation get the same treatment as `npm run markdownlint`.
  "ignores": [
    "node_modules/",
    // Local and gitignored -- see the matching note in eslint.config.mjs.
    // A `.claude/worktrees/` agent checkout carries both its own Markdown and
    // a vendored `node_modules/` full of it; excluding the directory covers
    // both, which is why no nested-`node_modules` glob is needed here.
    ".claude/",
    "release_announcement/",
    "dist/",
    "build/",
    "coverage/",
    "storybook-static/",
    "CHANGELOG.md",
    ".github/PULL_REQUEST_TEMPLATE.md",
  ],
}
